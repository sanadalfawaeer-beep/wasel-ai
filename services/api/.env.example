# DeepSeek is the planner model. It is OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Google Maps Platform server key (Routes API + Places API New).
# Leave empty to use the built-in University of Jordan demo route.
GOOGLE_MAPS_API_KEY=

# auto | mock | google
PLANNER_MODE=auto

# Set false to skip the LLM entirely and use the deterministic fallback parser.
USE_LLM=true

# Comma-separated origins. * is fine for local development.
ALLOWED_ORIGINS=*

DEBUG=true
REQUEST_TIMEOUT_S=12
