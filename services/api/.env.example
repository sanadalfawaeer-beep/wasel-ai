# DeepSeek is the planner model. It is OpenAI-compatible.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Google Maps Platform server key (Routes API + Places API New).
# Leave empty to use the built-in Amman demo routes.
GOOGLE_MAPS_API_KEY=

# auto | mock | google
PLANNER_MODE=auto

# auto | mock | google | ammanbus
# auto = Google when a key exists, otherwise mock.
# ammanbus = local snapshot of the official Amman Bus/BRT timetable.
TRANSIT_PROVIDER=auto
AMMANBUS_DATA_PATH=

# Set false to skip the LLM entirely and use the deterministic fallback parser.
USE_LLM=true

# Comma-separated origins. * is fine for local development.
ALLOWED_ORIGINS=*

DEBUG=true
REQUEST_TIMEOUT_S=12
AGENT_TIMEOUT_S=8

# TTS: auto | azure | edge. Auto prefers Azure when a key is configured.
# Edge TTS is suitable for a demo; use Azure Speech for a hosted pilot.
TTS_PROVIDER=auto
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
