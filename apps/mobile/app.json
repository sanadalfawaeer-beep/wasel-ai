{
  "expo": {
    "name": "Wasel AI",
    "slug": "wasel-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wasel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.waselai.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Wasel uses the microphone so you can say where you want to go.",
        "NSSpeechRecognitionUsageDescription": "Wasel uses speech recognition to understand your destination.",
        "NSLocationWhenInUseUsageDescription": "Wasel uses your location to guide you along the route."
      }
    },
    "android": {
      "package": "com.waselai.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D1117",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1117",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wasel uses your location to guide you along the route."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Wasel uses the microphone so you can say where you want to go.",
          "speechRecognitionPermission": "Wasel uses speech recognition to understand your destination."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
